{
  "name": "@hidock/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only MCP server for the HiDock Next knowledge database",
  "bin": {
    "hidock-mcp": "dist/server.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/server.ts --format esm --dts --clean",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "better-sqlite3": "^12.11.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.5",
    "typescript": "^5.6.3",
    "vitest": "^4.0.16"
  }
}
